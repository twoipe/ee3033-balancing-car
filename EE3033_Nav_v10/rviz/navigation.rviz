Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    # ---- 1) Mapping + localization -------------------------------------------------------------
    - Class: rviz_default_plugins/Map
      Name: Saved map (/map)
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR scan
      Enabled: true
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: AMCL pose + covariance
      Enabled: true
      Color: 0; 120; 255
      Topic:
        Value: /amcl_pose
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    # ---- 2) Search strategy --------------------------------------------------------------------
    - Class: rviz_default_plugins/PoseArray
      Name: Search sites
      Enabled: true
      Color: 255; 170; 0
      Topic:
        Value: /ee3033/search_sites
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Map
      Name: Camera coverage (swept area)
      Enabled: true
      Alpha: 0.45
      Color Scheme: costmap
      Topic:
        Value: /ee3033/coverage
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    # ---- 4) Navigation running: global plan, local controller, live obstacles -------------------
    - Class: rviz_default_plugins/Path
      Name: GLOBAL plan (A*)
      Enabled: true
      Color: 0; 200; 0
      Line Style: Billboards
      Line Width: 0.03
      Topic:
        Value: /astar_path
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Path
      Name: LOCAL controller (robot to look-ahead)
      Enabled: true
      Color: 255; 40; 40
      Line Style: Billboards
      Line Width: 0.06
      Topic:
        Value: /astar_local_path
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PoseArray
      Name: Live obstacles (LiDAR memory)
      Enabled: true
      Color: 160; 0; 255
      Arrow Length: 0.04
      Topic:
        Value: /astar_obstacles
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile
    # ---- 3) Detection + target localization -----------------------------------------------------
    - Class: rviz_default_plugins/Image
      Name: Camera (decompressed)
      Enabled: true
      Topic:
        Value: /camera/image_decompressed
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/Image
      Name: YOLO annotated image
      Enabled: true
      Topic:
        Value: /yolo/debug_image
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile
    - Class: rviz_default_plugins/PointStamped
      Name: Target (reported)
      Enabled: true
      Color: 255; 0; 255
      Radius: 0.12
      Topic:
        Value: /ee3033/target_map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top view
      Scale: 80
      X: 0
      Y: 0
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Width: 1500
