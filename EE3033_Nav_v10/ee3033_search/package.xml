<?xml version="1.0"?>
<package format="3">
  <name>ee3033_search</name>
  <version>10.0.0</version>
  <description>Coverage-based autonomous search, A* navigation and camera-bearing triangulation for the EE3033 balancing car.</description>
  <maintainer email="not-provided@example.invalid">EE3033 project group</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>yolo_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
